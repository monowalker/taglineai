# ============================================================================
# 商品キャッチフレーズ抽出 — 環境変数
# docker compose がこのファイルを読み込む。値を変えたら `docker compose up -d`。
# ============================================================================

# ---- 公開ポート -------------------------------------------------------------
# ブラウザからのアクセス先: http://localhost:${APP_PORT}
APP_PORT=8090

# ---- ローカル LLM (OpenAI 互換 API) ----------------------------------------
# 以下の LLM_* は models.yml が読めなかった場合のフォールバックとして使われる。
# 通常は models.yml でモデルを定義し、画面右上のプルダウンで切り替える。
# 同一ホスト上の llama.cpp / Ollama / LM Studio などを指す。
# コンテナからホストを見るため host.docker.internal を使う
# (docker-compose.yml の extra_hosts で host-gateway に解決される)。
LLM_API_BASE=http://host.docker.internal:8080/v1

# モデル名。llama.cpp のように単一モデルを配信するサーバでは何でもよいが、
# 複数モデルを持つサーバ (Ollama 等) では正確な ID を指定すること。
LLM_MODEL=Ornith-1.0-35B-UD-IQ4_NL.gguf

# API キー。不要なサーバでは空のままでよい (Authorization ヘッダを送らない)。
LLM_API_KEY=

# LLM 呼び出しのタイムアウト秒。ローカル LLM は遅いので長めに取る。
LLM_TIMEOUT=180

# LLM への同時リクエスト数。llama.cpp の --parallel (LLAMA_PARALLEL) 以下にすること。
LLM_CONCURRENCY=1

# 決定的な抽出のため 0 を推奨。生成ではなく選択させるタスクなので温度は上げない。
LLM_TEMPERATURE=0

# LLM の応答上限トークン数。
LLM_MAX_TOKENS=1024

# ---- 外部 LLM の API キー ------------------------------------------------
# models.yml の api_key: "${ANTHROPIC_API_KEY}" などから参照される。
# 使わないものは空のままでよい。
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ---- HTML 取得 --------------------------------------------------------------
# requests のタイムアウト秒 (仕様: 15秒)。
HTTP_TIMEOUT=15

# 送信する User-Agent。
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# ダウンロードを許可する HTML の最大バイト数 (巨大ページ対策)。
HTTP_MAX_BYTES=5000000

# HTML 取得の同時実行数。
FETCH_CONCURRENCY=4

# 追跡するリダイレクトの最大回数。
HTTP_MAX_REDIRECTS=5

# プライベート IP / ループバック宛の取得を許可するか。
# false = SSRF 対策として拒否 (インターネット上の商品ページのみ扱う本番向け)。
# true  = 社内サーバやローカルの検証用ページも読ませる (ローカル検証向け)。
HTTP_ALLOW_PRIVATE_HOSTS=true

# ---- 本文前処理 -------------------------------------------------------------
# 候補文として採用する文の最小 / 最大文字数。
MIN_SENTENCE_CHARS=8
MAX_SENTENCE_CHARS=140

# LLM に渡す候補文の最大件数と本文の最大文字数 (コンテキスト保護)。
MAX_CANDIDATES=120
MAX_BODY_CHARS=6000

# ---- 原文一致検証 -----------------------------------------------------------
# LLM 出力を原文に突き合わせる際の最低類似度 (0.0-1.0)。
# これを下回った候補は「生成された文」とみなして棄却する。
VERIFY_MIN_RATIO=0.75

# 棄却した出力について「LLM が狙っていた文」を探す際の最低類似度。
# 言い換えの場合は言い換え元の候補文をここで拾い、原文に着地させる。
# VERIFY_MIN_RATIO より低くすること (高くするとこの段は働かない)。
FALLBACK_MIN_RATIO=0.5

# ---- 1 リクエストあたりの URL 上限 -----------------------------------------
MAX_URLS_PER_REQUEST=20

# ---- 保存データ (観点プリセット / お手本) -----------------------------------
# 保存先ディレクトリ。docker-compose の named volume がマウントされる。
DATA_DIR=/data

# 保存できる観点プリセットの数。
MAX_PERSONA_PRESETS=5

# 👍 で貯まるお手本の保持件数 (これを超えると古いものから消える)。
MAX_EXAMPLES=10

# LLM のプロンプトに含めるお手本の最大件数。
MAX_PROMPT_EXAMPLES=6

# 観点プロンプトの最大文字数。
MAX_PERSONA_PROMPT_CHARS=400

# ---- ログ -------------------------------------------------------------------
LOG_LEVEL=INFO
